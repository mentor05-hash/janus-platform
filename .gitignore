# ── dependencies ──
node_modules/

# Claude Code 세션 워크트리(중첩 git 저장소 — 실수 커밋 방지)
.claude/worktrees/
.pnp
.pnp.js

# ── build output ──
dist/
build/
*.tsbuildinfo

# ── env / secrets (§5-10 민감정보: 절대 커밋 금지) ──
.env
.env.*
!.env.example

# ── prisma 생성물 ──
apps/api/prisma/generated/

# ── 첨부/업로드(StorageProvider local) ──
uploads/
apps/api/uploads/

# ── 로그 / 캐시 ──
*.log
npm-debug.log*
.npm/
coverage/
.cache/

# ── OS / editor ──
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
marketing/dist/

# ── janus §1-2 저작권·민감 데이터 (git 절대 금지 — janus-data 로컬 전용) ──
# 데이터 경로는 코드에서 JANUS_DATA_DIR ENV 로만 참조(하드코딩 금지)
data/
seed-restricted/
janus-data/
20_data/
# 티어 빌드 산출 중 회원 이상(임베드 데이터 포함) — 무료판만 배포
dist-tier/
scratch-disttier/
# 저작권 데이터 파일 패턴(어디가·esteacher·고속 — 재배포 금지 조건)
adiga_*.json
esteacher_*.json
고속_*.json
보정_calib_*.json
*_INTERNAL.json
admission-data.json
# 배치표 목표컷(N29) — 실컷은 JANUS_DATA_DIR/placement-hub/ 에만. repo 내 어느 경로든 차단.
# 예시 파일은 ops/placement/targets.example.json(합성) 하나만 허용.
targets.json
placement-hub/
!ops/placement/targets.example.json
# ⚠ 위 `placement-hub/` 는 **어느 깊이의 동명 디렉토리든** 잡는다 — API 소스 모듈까지 그림자에 든다.
#   기존 파일은 추적 중이라 무해하지만, 그 모듈에 새 파일을 만들면 git status 에도 안 뜨고 조용히 누락된다
#   (실측 2026-08-12). 데이터 차단은 유지하되 소스는 되살린다.
!apps/api/src/modules/placement-hub/
