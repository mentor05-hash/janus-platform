<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  터널 감시자 자동시작 (macOS launchd). 재부팅·크래시 후에도 외부 접속이 살아있게 한다.
  설치·해제는 ops/README.md 참조. REPLACE_HOME 은 설치 시 실제 홈 경로로 치환된다.

  값(터널 토큰·URL·도메인)은 이 파일에 넣지 않는다 — 감시자 스크립트가 자기 설정파일/ENV 에서 읽는다.
  plist 는 "무엇을 언제 띄울지"만 담는다(CLAUDE.md §4).
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.janus.tunnels</string>

  <key>ProgramArguments</key>
  <array>
    <string>REPLACE_HOME/mentoring-tunnels/run.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>REPLACE_HOME/mentoring-tunnels</string>

  <!-- 로그인 시 시작 + 죽으면 재시작. run.sh 에 단일 인스턴스 가드가 있어 중복 기동되지 않는다. -->
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>

  <!-- 재시작 폭주 방지 — 즉시 실패가 반복될 때 10초 간격을 둔다. -->
  <key>ThrottleInterval</key>
  <integer>10</integer>

  <key>StandardOutPath</key>
  <string>REPLACE_HOME/mentoring-tunnels/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>REPLACE_HOME/mentoring-tunnels/launchd.err.log</string>

  <!-- GUI 로그인 세션에서 실행(LaunchAgents) — 네트워크·키체인 접근 필요. -->
  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
