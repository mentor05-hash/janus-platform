{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 0,
  "title": "Janus — API Overview",
  "uid": "janus-overview",
  "tags": ["janus"],
  "timezone": "browser",
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "30s",
  "schemaVersion": 39,
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "title": "서비스 up",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "fieldConfig": { "defaults": { "mappings": [{ "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }] }, "overrides": [] },
      "targets": [{ "expr": "up{job=~\"janus-.*\"}", "legendFormat": "{{job}}", "refId": "A" }]
    },
    {
      "id": 2,
      "title": "요청량 (req/s by route)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 18, "x": 6, "y": 0 },
      "targets": [{ "expr": "sum(rate(http_requests_total[5m])) by (route)", "legendFormat": "{{route}}", "refId": "A" }]
    },
    {
      "id": 3,
      "title": "p95 요청 지연 (s)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket[5m])))", "legendFormat": "p95", "refId": "A" }]
    },
    {
      "id": 4,
      "title": "에러율 (app_errors_total /s)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [{ "expr": "sum(rate(app_errors_total[5m]))", "legendFormat": "errors/s", "refId": "A" }]
    },
    {
      "id": 5,
      "title": "이벤트루프 지연 (s)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 16 },
      "targets": [{ "expr": "nodejs_eventloop_lag_seconds{job=~\"janus-.*\"}", "legendFormat": "{{job}}", "refId": "A" }]
    },
    {
      "id": 6,
      "title": "프로세스 메모리 (RSS bytes)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 16 },
      "targets": [{ "expr": "process_resident_memory_bytes{job=~\"janus-.*\"}", "legendFormat": "{{job}}", "refId": "A" }]
    }
  ]
}
