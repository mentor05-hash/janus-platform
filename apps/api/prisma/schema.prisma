}

model academy_enrollment {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id       String   @db.Uuid
  academy_id    String   @db.Uuid
  status        String   @default("self_reported")
  consent_stats Boolean  @default(false)
  school        String?
  ts            DateTime @default(now()) @db.Timestamptz(6)
  academy       academy  @relation(fields: [academy_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, academy_id])
  @@index([academy_id])
}

model academy_lead {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id      String         @db.Uuid
  academy_id   String         @db.Uuid
  class_id     String?        @db.Uuid
  summary_json Json           @default("{}")
  status       String         @default("sent")
  ts           DateTime       @default(now()) @db.Timestamptz(6)
  academy      academy        @relation(fields: [academy_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  klass        academy_class? @relation(fields: [class_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([academy_id])
  @@index([user_id])
}

// ── 본부 결정 ① 학부모 동의·본인확인 — (guardian,student)당 본인확인+전달동의. account 참조는 스칼라 격리. ──
model guardian_data_consent {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  guardian_id            String    @db.Uuid
  student_id             String    @db.Uuid
  verify_status          String    @default("unverified")
  verify_method          String?
  verified_name          String?
  verify_ref             String?
  verify_provider        String    @default("stub")
  verified_at            DateTime? @db.Timestamptz(6)
  consent_delivery       Boolean   @default(false)
  consent_policy_version String    @default("v1")
  consent_at             DateTime? @db.Timestamptz(6)
  revoked_at             DateTime? @db.Timestamptz(6)
  created_at             DateTime  @default(now()) @db.Timestamptz(6)
  updated_at             DateTime  @default(now()) @db.Timestamptz(6)

  @@unique([guardian_id, student_id])
  @@index([student_id])
}

/// *
///  * 학사일정(academic_event) — 수능·모의고사·신청기간·내신 등. center_id NULL=전국(본사),
///  * 값=센터 자체 일정. reminded=발송한 오프셋(d7/d1/d0) 기록으로 중복 방지.
model academic_event {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  center_id   String?   @db.Uuid
  title       String
  type        String    @default("etc")
  start_date  DateTime  @db.Date
  end_date    DateTime? @db.Date
  grade       String?
  description String?
  reminded    String[]  @default([])
  created_by  String?   @db.Uuid
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  updated_at  DateTime  @default(now()) @db.Timestamptz(6)

  @@index([start_date])
  @@index([center_id, start_date])
}

/// 목표 후보 — 기준 목표(student_profile.goal_*) 외 비교용 후보 N개. 학생이 직접 등록·본인만 조회.
/// cut 단위는 mode 에 따름(jeongsi=전국누백% / susi=내신등급) — gap-report 도메인과 동일 규약.
/// cut 은 배치표 데이터 또는 수동 입력값만 보관(O65 — 플랫폼 산출 금지), cut_source 로 감사.
/// 자동 제안·조합 추천·종합 합격확률은 여기서 하지 않는다(전자는 실컷 데이터 선행, 후자는 N28 미결).
/// 용어: '플랜'(planner·category='plan'·subscription_plan)·'포트폴리오'(N28 예약)와 구분해 candidate.
model student_goal_candidate {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  student_id String   @db.Uuid
  mode       String
  univ       String
  dept       String
  track      String?
  cut        Decimal  @db.Decimal(6, 2)
  cut_source String   @default("manual")
  note       String?
  sort_order Int      @default(0)
  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@index([student_id, mode])
}

/// 맞춤 할 일(체크리스트) — 격차·학사일정 자동 제안 + 수동. source_key 로 자동생성 멱등(부분 유니크는 DB 인덱스).
/// category: gap|academic|consult|qna|custom, 그리고 'plan' 예약 — planner 학습량 원장(성적맹 Sealed<T>)이
/// 향후 같은 셸에 category='plan' 로 렌더(O100 D1: student_task[액션 인박스] ↔ planner.Todo[학습량 원장] 두 축 공존).
model student_task {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  student_id String    @db.Uuid
  title      String
  category   String    @default("custom")
  subject    String?
  due_date   DateTime? @db.Date
  status     String    @default("todo")
  source_key String?
  cta_href   String?
  created_by String    @default("self")
  reminded   String[]  @default([])
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  done_at    DateTime? @db.Timestamptz(6)

  @@index([student_id, status])
}
