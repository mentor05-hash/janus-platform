generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model account {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  role            account_role
  center_id       String?          @db.Uuid
  login_id        String           @unique
  pw_hash         String
  name            String
  status          account_status   @default(pending)
  created_at      DateTime         @default(now()) @db.Timestamptz(6)
  center          center?          @relation(fields: [center_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  guardian        guardian?
  notification    notification[]
  payment         payment[]
  staff_profile   staff_profile?
  student_profile student_profile?
  teacher_profile teacher_profile?
}

model blocked_time {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  center_id    String      @db.Uuid
  type         String?
  start_at     DateTime    @db.Timestamptz(6)
  end_at       DateTime    @db.Timestamptz(6)
  scope        String?
  set_by_level perm_level?
  center       center      @relation(fields: [center_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model board_question {
  id                                                                  String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  student_id                                                          String           @db.Uuid
  consult_type                                                        consult_type?
  q_type                                                              board_qtype
  scope                                                               board_scope
  assigned_teacher_id                                                 String?          @db.Uuid
  difficulty                                                          String?
  attachments                                                         Json?
  charge                                                              Int?
  status                                                              String?          @default("open")
  taken_teacher_id                                                    String?          @db.Uuid
  created_at                                                          DateTime         @default(now()) @db.Timestamptz(6)
  teacher_profile_board_question_assigned_teacher_idToteacher_profile teacher_profile? @relation("board_question_assigned_teacher_idToteacher_profile", fields: [assigned_teacher_id], references: [account_id], onDelete: NoAction, onUpdate: NoAction)
  student_profile                                                     student_profile  @relation(fields: [student_id], references: [account_id], onDelete: NoAction, onUpdate: NoAction)
  teacher_profile_board_question_taken_teacher_idToteacher_profile    teacher_profile? @relation("board_question_taken_teacher_idToteacher_profile", fields: [taken_teacher_id], references: [account_id], onDelete: NoAction, onUpdate: NoAction)
}

model booking {
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  student_id         String               @db.Uuid
  teacher_id         String               @db.Uuid
  center_id          String?              @db.Uuid
  consult_type       consult_type
  sub_type           String?
  mode               consult_mode
  session_mode       session_mode?
  direction          booking_dir          @default(student)
  start_at           DateTime?            @db.Timestamptz(6)
  end_at             DateTime?            @db.Timestamptz(6)
  buffer_before      Int?                 @default(10) @db.SmallInt
  buffer_after       Int?                 @default(10) @db.SmallInt
  status             booking_status       @default(new)
  room_id            String?              @db.Uuid
  meeting_url        String?
  attachments        Json?
  content            String?
  charged_credits    Int?                 @default(0)
  origin             String?
  created_at         DateTime             @default(now()) @db.Timestamptz(6)
  center             center?              @relation(fields: [center_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  room               room?                @relation(fields: [room_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  student_profile    student_profile      @relation(fields: [student_id], references: [account_id], onDelete: NoAction, onUpdate: NoAction)
  teacher_profile    teacher_profile      @relation(fields: [teacher_id], references: [account_id], onDelete: NoAction, onUpdate: NoAction)
  cancellation_event cancellation_event[]
  consultation_note  consultation_note?
  review             review?
  time_slot          time_slot[]

  @@index([student_id, status], map: "idx_booking_student")
  @@index([teacher_id, start_at], map: "idx_booking_teacher")
}

model cancellation_event {
  id                    String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  booking_id            String        @db.Uuid
  reason                String?
  route                 cancel_route?
  notify_targets        String[]      @default([])
  channels              String[]      @default([])
  credit_refunded       Int?          @default(0)
  cancelled_by          String?       @db.Uuid // 발생자(account id) — 0002
  substitute_candidates String[]      @default([]) @db.Uuid // 대체후보 teacher id — 0002
  created_at            DateTime      @default(now()) @db.Timestamptz(6)
  booking               booking       @relation(fields: [booking_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model category_mode_policy {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  center_id     String?        @db.Uuid
  consult_type  consult_type
  allowed_modes consult_mode[] @default([])
  center        center?        @relation(fields: [center_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model center {
  id                           String                         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                         String
  region                       String?
  created_at                   DateTime                       @default(now()) @db.Timestamptz(6)
  account                      account[]
  blocked_time                 blocked_time[]
  booking                      booking[]
  category_mode_policy         category_mode_policy[]
  consultation_policy          consultation_policy?
  evaluation_weight_policy     evaluation_weight_policy[]
  feature_availability         feature_availability[]
  material                     material[]
  guardian_visibility_policy   guardian_visibility_policy?
  limit_policy                 limit_policy?
  ops_stat                     ops_stat[]
  payroll_policy               payroll_policy[]
  penalty_policy               penalty_policy?
  pricing_policy               pricing_policy[]
  room                         room[]
  staff_profile                staff_profile[]
  student_profile              student_profile[]
  teacher_offline_availability teacher_offline_availability[]
  teacher_profile              teacher_profile[]
  zoom_policy                  zoom_policy?
}

model consultation_note {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  booking_id       String          @unique @db.Uuid
  student_id       String          @db.Uuid
  teacher_id       String          @db.Uuid
  consult_type     consult_type?
  sub_type         String?
  core_summary     String?
  memo             String?
  homework         String?
  future_dir       String?
  guardian_visible Boolean?        @default(true)
  save_state       note_save_state @default(draft)
  author_id        String?         @db.Uuid
  created_at       DateTime        @default(now()) @db.Timestamptz(6)
  updated_at       DateTime        @default(now()) @db.Timestamptz(6)
  booking          booking         @relation(fields: [booking_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  student_profile  student_profile @relation(fields: [student_id], references: [account_id], onDelete: NoAction, onUpdate: NoAction)
  teacher_profile  teacher_profile @relation(fields: [teacher_id], references: [account_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([student_id, created_at(sort: Desc)], map: "idx_note_student")
}

model consultation_policy {
  center_id           String @id @db.Uuid
  homeroom_cycle_days Int?   @default(30) @db.SmallInt
  warn_days           Int?   @db.SmallInt
  danger_days         Int?   @db.SmallInt
  center              center @relation(fields: [center_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model credit_account {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  student_id          String                @unique @db.Uuid
  purchased_balance   Int                   @default(0)
  granted_balance     Int                   @default(0)
  grant_expire_at     DateTime?             @db.Timestamptz(6)
  reserved_credits    Int                   @default(0)
  student_profile     student_profile       @relation(fields: [student_id], references: [account_id], onDelete: Cascade, onUpdate: NoAction)
  credit_transaction  credit_transaction[]
  weekly_credit_grant weekly_credit_grant[]
}

model credit_transaction {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  account_id     String          @db.Uuid
  type           credit_txn_type
  amount         Int
  balance        Int
  description    String?
  method         String?
  ref_type       String?
  ref_id         String?         @db.Uuid
  meta           Json? // 소비 분배 내역(부여분/구매분) — 환원 복원용 (0004)
  created_at     DateTime        @default(now()) @db.Timestamptz(6)
  credit_account credit_account  @relation(fields: [account_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([account_id, created_at(sort: Desc)], map: "idx_credit_txn_acct")
}

model feature_availability {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scope        String
  center_id    String?   @db.Uuid
  target_type  String
  target_value String
  period_start DateTime? @db.Date
  period_end   DateTime? @db.Date
  enabled      Boolean   @default(true)
  center       center?   @relation(fields: [center_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model guardian {
  account_id            String                  @id @db.Uuid
  notify_settings       Json?
  account               account                 @relation(fields: [account_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  guardian_student_link guardian_student_link[]
  payment_request       payment_request[]
}

model guardian_student_link {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  guardian_id     String          @db.Uuid
  student_id      String          @db.Uuid
  relation        String?
  status          String          @default("pending")
  link_method     String?
  guardian        guardian        @relation(fields: [guardian_id], references: [account_id], onDelete: Cascade, onUpdate: NoAction)
  student_profile student_profile @relation(fields: [student_id], references: [account_id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([guardian_id, student_id])
}

model guardian_visibility_policy {
  center_id   String @id @db.Uuid
  base_policy String @default("by_type")
  center      center @relation(fields: [center_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model limit_policy {
  center_id            String @id @db.Uuid
  reservation_limit    Int?   @db.SmallInt
  classify_fit_limit   Int?   @default(10) @db.SmallInt
  classify_unfit_limit Int?   @default(30) @db.SmallInt
  center               center @relation(fields: [center_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model match_request {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  student_id        String          @db.Uuid
  direction         booking_dir     @default(student)
  consult_type      consult_type?
  sub_type          String?
  mode_pref         String?
  stay_time         Json?
  result_booking_id String?         @db.Uuid
  fallback          String?
  created_at        DateTime        @default(now()) @db.Timestamptz(6)
  student_profile   student_profile @relation(fields: [student_id], references: [account_id], onDelete: NoAction, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model membership_grade {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                String
  tier                Int                   @db.SmallInt
  weekly_credits      Int                   @default(0)
  expire_policy       String                @default("end_of_week")
  priority            Int                   @default(0) @db.SmallInt
  student_profile     student_profile[]
  subscription_plan   subscription_plan[]
  weekly_credit_grant weekly_credit_grant[]
}

model notification {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recipient_id    String    @db.Uuid
  type            String?
  channels        String[]  @default([])
  payload         Json?
  delivery        Json?
  attempts        Int       @default(0)
  last_attempt_at DateTime? @db.Timestamptz(6)
  read_at         DateTime? @db.Timestamptz(6)
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  account      account   @relation(fields: [recipient_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model ops_stat {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  center_id        String?  @db.Uuid
  period           String?
  active_users     Int?
  match_rate       Decimal? @db.Decimal(4, 1)
  avg_satisfaction Decimal? @db.Decimal(2, 1)
  weekly_consult   Int?
  grade_dist       Json?
  weekly_trend     Json?
  teacher_stats    Json?
  center           center?  @relation(fields: [center_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model payment {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  payer_account_id String   @db.Uuid
  amount           Int
  pg_provider      String?
  pg_txn_id        String?
  target           String?
  status           String?  @default("pending")
  created_at       DateTime @default(now()) @db.Timestamptz(6)
  account          account  @relation(fields: [payer_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model payment_request {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  student_id      String          @db.Uuid
  guardian_id     String?         @db.Uuid
  needed_credits  Int
  ref_type        String?
  ref_id          String?         @db.Uuid
  status          payreq_status   @default(open)
  origin          payreq_origin   @default(manual)
  expire_at       DateTime?       @db.Timestamptz(6)
  channels        String[]        @default([])
  created_at      DateTime        @default(now()) @db.Timestamptz(6)
  guardian        guardian?       @relation(fields: [guardian_id], references: [account_id], onDelete: NoAction, onUpdate: NoAction)
  student_profile student_profile @relation(fields: [student_id], references: [account_id], onDelete: NoAction, onUpdate: NoAction)
}

model payroll_estimate {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teacher_id       String          @db.Uuid
  cycle            String?
  confirmed_amount Int?            @default(0)
  expected_amount  Int?            @default(0)
  breakdown        Json?
  period_start     DateTime?       @db.Date
  period_end       DateTime?       @db.Date
  teacher_profile  teacher_profile @relation(fields: [teacher_id], references: [account_id], onDelete: Cascade, onUpdate: NoAction)
}

model member_type {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind       String
  code       String
  label      String
  sort_order Int      @default(0)
  active     Boolean  @default(true)
  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@unique([kind, code])
}

model scheduled_announcement {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_by   String    @db.Uuid
  targets      String[]
  title        String
  body         String
  center_id    String?   @db.Uuid
  channels     String[]  @default(["app"])
  scheduled_at DateTime  @db.Timestamptz(6)
  status        String    @default("pending")
  sent_at       DateTime? @db.Timestamptz(6)
  sent_count    Int?
  reminder_sent Boolean   @default(false)
  created_at    DateTime  @default(now()) @db.Timestamptz(6)

  @@index([status, scheduled_at])
}

model announcement_template {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_by String   @db.Uuid
  center_id  String?  @db.Uuid
  name       String
  targets    String[]
  title      String
  body       String
  channels   String[] @default(["app"])
  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@index([center_id])
}

model stored_file {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  owner_id     String     @db.Uuid
  storage_key  String
  filename     String
  content_type String
  size         Int
  created_at   DateTime   @default(now()) @db.Timestamptz(6)
  material     material[]

  @@index([owner_id])
}

model material {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teacher_id  String          @db.Uuid
  center_id   String?         @db.Uuid
  file_id     String?         @db.Uuid
  title       String
  description String?
  subject     String?
  category    String?
  visibility  String          @default("center")
  view_count  Int             @default(0)
  created_at  DateTime        @default(now()) @db.Timestamptz(6)
  teacher     teacher_profile @relation(fields: [teacher_id], references: [account_id], onDelete: Cascade, onUpdate: NoAction)
  center      center?         @relation(fields: [center_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  file        stored_file?    @relation(fields: [file_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([center_id])
  @@index([teacher_id])
}

model category {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind       String
  name       String
  sort_order Int      @default(0)
  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@unique([kind, name])
}

model payroll_policy {
  id               String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  center_id        String? @db.Uuid
  teacher_category String?
  cycle            String  @default("monthly")
  per_case_rate    Int?
  qna_rate         Int?
  grade_allowance  Json?
  hourly_rate      Int?
  auto_incentive   Json?
  center           center? @relation(fields: [center_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model penalty_policy {
  center_id           String   @id @db.Uuid
  cancel_threshold    Int?     @db.SmallInt
  noshow_threshold    Int?     @db.SmallInt
  reject_threshold    Int?     @db.SmallInt
  restrict_minutes    Int?
  ranking_weight_down Decimal? @db.Decimal(4, 2)
  center              center   @relation(fields: [center_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model pricing_policy {
  id                    String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  center_id             String?      @db.Uuid
  mode                  consult_mode
  enabled               Boolean      @default(true)
  paid                  Boolean      @default(true)
  per_hour              Int          @default(0)
  surcharge_pct         Int          @default(0) @db.SmallInt
  board_item_fee        Int?
  board_general_fee     Int?
  offline_occupancy_fee Int?
  paid_consulting_fee   Int?
  updated_by            String?      @db.Uuid
  updated_at            DateTime?    @default(now()) @db.Timestamptz(6)
  center                center?      @relation(fields: [center_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model qna_answer {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  post_id         String          @db.Uuid
  teacher_id      String          @db.Uuid
  body            String?
  accepted        Boolean?        @default(false)
  pay_eligible    Boolean?        @default(false)
  created_at      DateTime        @default(now()) @db.Timestamptz(6)
  qna_post        qna_post        @relation(fields: [post_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  teacher_profile teacher_profile @relation(fields: [teacher_id], references: [account_id], onDelete: NoAction, onUpdate: NoAction)
}

model qna_post {
  id                  String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  student_id          String           @db.Uuid
  subject             String?
  difficulty          String?
  scope               board_scope?     @default(open)
  assigned_teacher_id String?          @db.Uuid
  body                String?
  attachments         Json?
  status              String?          @default("open")
  created_at          DateTime         @default(now()) @db.Timestamptz(6)
  qna_answer          qna_answer[]
  teacher_profile     teacher_profile? @relation(fields: [assigned_teacher_id], references: [account_id], onDelete: NoAction, onUpdate: NoAction)
  student_profile     student_profile  @relation(fields: [student_id], references: [account_id], onDelete: NoAction, onUpdate: NoAction)
}

model report {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  target_type String?
  target_id   String?  @db.Uuid
  reason      String?
  status      String?  @default("received")
  action      String?
  center_id   String?  @db.Uuid // 센터 스코프(0003)
  ai_review   Json? // AI 1차 검토 결과 보존(0003)
  created_at  DateTime @default(now()) @db.Timestamptz(6)
}

model review {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  booking_id      String          @unique @db.Uuid
  student_id      String          @db.Uuid
  teacher_id      String          @db.Uuid
  rating_attitude Int?            @db.SmallInt
  rating_content  Int?            @db.SmallInt
  rating_skill    Int?            @db.SmallInt
  rating_again    Int?            @db.SmallInt
  text            String?
  done_confirmed  Boolean?        @default(false)
  reported        Boolean?        @default(false)
  created_at      DateTime        @default(now()) @db.Timestamptz(6)
  booking         booking         @relation(fields: [booking_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  student_profile student_profile @relation(fields: [student_id], references: [account_id], onDelete: NoAction, onUpdate: NoAction)
  teacher_profile teacher_profile @relation(fields: [teacher_id], references: [account_id], onDelete: NoAction, onUpdate: NoAction)
}

model room {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  center_id       String    @db.Uuid
  type            String?
  capacity        Int?      @default(1) @db.SmallInt
  operating_hours String?
  setting         String?   @default("auto")
  status          String?   @default("available")
  booking         booking[]
  center          center    @relation(fields: [center_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model staff_profile {
  account_id String     @id @db.Uuid
  staff_role String?
  center_id  String?    @db.Uuid
  perm_level perm_level @default(L2)
  account    account    @relation(fields: [account_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  center     center?    @relation(fields: [center_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model student_profile {
  account_id             String                  @id @db.Uuid
  center_id              String?                 @db.Uuid
  stay_time              Json?
  membership_grade_id    String?                 @db.Uuid
  active_subscription_id String?                 @db.Uuid
  homeroom_teacher_id    String?                 @db.Uuid
  homeroom_assigned_at   DateTime?               @db.Timestamptz(6)
  total_consult          Int?                    @default(0)
  done_count             Int?                    @default(0)
  rejected_count         Int?                    @default(0)
  noshow_count           Int?                    @default(0)
  same_day_cancel_count  Int?                    @default(0)
  penalty_since          DateTime?               @db.Timestamptz(6)
  type_code              String?
  last_consult_at        DateTime?               @db.Timestamptz(6)
  last_homeroom_at       DateTime?               @db.Timestamptz(6)
  reverse_admin          Boolean                 @default(false)
  reverse_self           Boolean                 @default(false)
  board_question         board_question[]
  booking                booking[]
  consultation_note      consultation_note[]
  credit_account         credit_account?
  guardian_student_link  guardian_student_link[]
  match_request          match_request[]
  payment_request        payment_request[]
  qna_post               qna_post[]
  review                 review[]
  account                account                 @relation(fields: [account_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  center                 center?                 @relation(fields: [center_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  teacher_profile        teacher_profile?        @relation(fields: [homeroom_teacher_id], references: [account_id], onDelete: NoAction, onUpdate: NoAction)
  membership_grade       membership_grade?       @relation(fields: [membership_grade_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  student_subscription   student_subscription[]
  teacher_block          teacher_block[]
  teacher_list_entry     teacher_list_entry[]
}

model student_subscription {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  student_id        String            @db.Uuid
  plan_id           String            @db.Uuid
  status            String?           @default("active")
  started_at        DateTime?         @default(now()) @db.Timestamptz(6)
  next_billing_at   DateTime?         @db.Timestamptz(6)
  subscription_plan subscription_plan @relation(fields: [plan_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  student_profile   student_profile   @relation(fields: [student_id], references: [account_id], onDelete: Cascade, onUpdate: NoAction)
}

model subscription_plan {
  id                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                 String
  price                Int
  billing_cycle        billing_cycle
  payer                payer_t                @default(guardian)
  grade_id             String?                @db.Uuid
  student_subscription student_subscription[]
  membership_grade     membership_grade?      @relation(fields: [grade_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model teacher_block {
  student_id      String          @db.Uuid
  teacher_id      String          @db.Uuid
  student_profile student_profile @relation(fields: [student_id], references: [account_id], onDelete: NoAction, onUpdate: NoAction)
  teacher_profile teacher_profile @relation(fields: [teacher_id], references: [account_id], onDelete: NoAction, onUpdate: NoAction)

  @@id([student_id, teacher_id])
}

model teacher_grade {
  teacher_id      String          @id @db.Uuid
  grade           teacher_grade_t
  top_percent     Decimal?        @db.Decimal(4, 1)
  next_review_at  DateTime?       @db.Date
  allowance       Json?
  teacher_profile teacher_profile @relation(fields: [teacher_id], references: [account_id], onDelete: Cascade, onUpdate: NoAction)
}

model teacher_list_entry {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  student_id      String          @db.Uuid
  teacher_id      String          @db.Uuid
  list_kind       list_kind
  student_profile student_profile @relation(fields: [student_id], references: [account_id], onDelete: Cascade, onUpdate: NoAction)
  teacher_profile teacher_profile @relation(fields: [teacher_id], references: [account_id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([student_id, teacher_id])
}

model teacher_offline_availability {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teacher_id      String          @db.Uuid
  center_id       String          @db.Uuid
  enabled         Boolean         @default(false)
  time_windows    Json            @default("[]")
  center          center          @relation(fields: [center_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  teacher_profile teacher_profile @relation(fields: [teacher_id], references: [account_id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([teacher_id, center_id])
}

model teacher_profile {
  account_id                                                         String                         @id @db.Uuid
  center_id                                                          String?                        @db.Uuid
  subjects                                                           String[]                       @default([])
  sub_subjects                                                       String[]                       @default([])
  grade                                                              teacher_grade_t                @default(B)
  career                                                             String?
  rating                                                             Decimal?                       @default(0) @db.Decimal(2, 1)
  total_consult                                                      Int?                           @default(0)
  re_request_rate                                                    Decimal?                       @db.Decimal(4, 1)
  avg_response_min                                                   Int?
  pay_base                                                           Int?
  teacher_category                                                   String?
  type_code                                                          String?
  cancel_count                                                       Int                            @default(0)
  director_role                                                      String?
  teacher_monthly_hours                                              teacher_monthly_hours[]
  material                                                           material[]
  board_question_board_question_assigned_teacher_idToteacher_profile board_question[]               @relation("board_question_assigned_teacher_idToteacher_profile")
  board_question_board_question_taken_teacher_idToteacher_profile    board_question[]               @relation("board_question_taken_teacher_idToteacher_profile")
  booking                                                            booking[]
  consultation_note                                                  consultation_note[]
  payroll_estimate                                                   payroll_estimate[]
  qna_answer                                                         qna_answer[]
  qna_post                                                           qna_post[]
  review                                                             review[]
  student_profile                                                    student_profile[]
  teacher_block                                                      teacher_block[]
  teacher_grade                                                      teacher_grade?
  teacher_list_entry                                                 teacher_list_entry[]
  teacher_offline_availability                                       teacher_offline_availability[]
  account                                                            account                        @relation(fields: [account_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  center                                                             center?                        @relation(fields: [center_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  time_slot                                                          time_slot[]
  work_schedule                                                      work_schedule[]
}

model evaluation_weight_policy {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  center_id      String?  @db.Uuid
  w_total        Int      @default(20) @db.SmallInt
  w_completion   Int      @default(20) @db.SmallInt
  w_rerequest    Int      @default(15) @db.SmallInt
  w_reject       Int      @default(10) @db.SmallInt
  w_noshow       Int      @default(10) @db.SmallInt
  w_response     Int      @default(10) @db.SmallInt
  w_satisfaction Int      @default(15) @db.SmallInt
  updated_by     String?  @db.Uuid
  updated_at     DateTime @default(now()) @db.Timestamptz(6)
  center         center?  @relation(fields: [center_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model teacher_monthly_hours {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teacher_id      String          @db.Uuid
  year_month      String          @db.Char(7)
  hours           Decimal         @default(0) @db.Decimal(6, 1)
  updated_by      String?         @db.Uuid
  updated_at      DateTime        @default(now()) @db.Timestamptz(6)
  teacher_profile teacher_profile @relation(fields: [teacher_id], references: [account_id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([teacher_id, year_month])
}

model time_slot {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teacher_id      String          @db.Uuid
  slot_date       DateTime        @db.Date
  slot_index      Int             @db.SmallInt
  status          String          @default("work")
  booking_id      String?         @db.Uuid
  booking         booking?        @relation(fields: [booking_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  teacher_profile teacher_profile @relation(fields: [teacher_id], references: [account_id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([teacher_id, slot_date, slot_index])
}

model weekly_credit_grant {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  account_id       String            @db.Uuid
  grade_id         String?           @db.Uuid
  amount           Int
  granted_at       DateTime          @default(now()) @db.Timestamptz(6)
  expire_at        DateTime          @db.Timestamptz(6)
  remaining        Int
  credit_account   credit_account    @relation(fields: [account_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  membership_grade membership_grade? @relation(fields: [grade_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model work_schedule {
  id                    String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teacher_id            String          @db.Uuid
  recurring_template    Json            @default("{}")
  weekly_overrides      Json            @default("[]")
  week_plans            Json            @default("[]")
  pre_book_horizon_days Int             @default(30)
  teacher_profile       teacher_profile @relation(fields: [teacher_id], references: [account_id], onDelete: Cascade, onUpdate: NoAction)
}

model zoom_policy {
  center_id        String @id @db.Uuid
  concurrent_limit Int    @default(6) @db.SmallInt
  allow_map        Json   @default("{}")
  center           center @relation(fields: [center_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

