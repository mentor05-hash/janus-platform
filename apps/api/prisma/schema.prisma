generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model account {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  role                account_role
  center_id           String?               @db.Uuid
  login_id            String                @unique
  pw_hash             String
  name                String
  status              account_status        @default(pending)
  email               String?
  phone               String?
  email_verified      Boolean               @default(false)
  phone_verified      Boolean               @default(false)
  withdrawn_at        DateTime?             @db.Timestamptz(6)
  withdrawal_reason   String?
  created_at          DateTime              @default(now()) @db.Timestamptz(6)
  center              center?               @relation(fields: [center_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  guardian            guardian?
  notification        notification[]
  payment             payment[]
  staff_profile       staff_profile?
  student_profile     student_profile?
  teacher_profile     teacher_profile?
  user_consent        user_consent?
  push_token          push_token[]
  service_entitlement service_entitlement[] @relation("entitlement_owner")
}

model push_token {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  account_id   String   @db.Uuid
  token        String   @unique
  platform     String?
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  last_seen_at DateTime @default(now()) @db.Timestamptz(6)
  account      account  @relation(fields: [account_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([account_id])
}

model chat_message {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  booking_id    String    @db.Uuid
  sender_id     String?   @db.Uuid
  kind          String    @default("text")
  body          String?
  image_file_id String?   @db.Uuid
  reply_to_id   String?   @db.Uuid
  reactions     Json      @default("{}")
  read_at       DateTime? @db.Timestamptz(6)
  deleted_at    DateTime? @db.Timestamptz(6) // soft delete(회수) — 원문은 감사·분쟁 대응 위해 보존, 표시만 차단
  created_at    DateTime  @default(now()) @db.Timestamptz(6)
  booking       booking   @relation(fields: [booking_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([booking_id, created_at])
}

model whiteboard_snapshot {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  booking_id         String   @db.Uuid
  strokes            Json
  background_file_id String?  @db.Uuid
  created_by         String?  @db.Uuid
  created_at         DateTime @default(now()) @db.Timestamptz(6)
  booking            booking  @relation(fields: [booking_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([booking_id, created_at])
}

model system_setting {
  key        String   @id
  value      Json
  updated_by String?  @db.Uuid
  updated_at DateTime @default(now()) @db.Timestamptz(6)
}

// 생기부 가드 스텝3 (migrations/0090). 무취급: 메타데이터만(파일명·내용 미저장).
model school_record_block_event {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reason     String
  stage      String?
  surface    String   @default("unknown")
  actor_id   String?  @db.Uuid
  actor_role String?
  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@index([created_at(sort: Desc)], map: "sr_block_event_created_idx")
  @@index([reason], map: "sr_block_event_reason_idx")
}

model school_record_appeal {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reason      String
  surface     String?
  note        String?
  actor_id    String?   @db.Uuid
  actor_role  String?
  status      String    @default("open")
  resolution  String?
  resolved_by String?   @db.Uuid
  resolved_at DateTime? @db.Timestamptz(6)
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  updated_at  DateTime  @default(now()) @db.Timestamptz(6)

  @@index([actor_id], map: "sr_appeal_actor_idx")
  @@index([status, created_at(sort: Desc)], map: "sr_appeal_status_idx")
}

model score_report {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  student_id     String          @db.Uuid
  center_id      String?         @db.Uuid
  period         String
  exam_type      String?
  report_file_id String?         @db.Uuid
  source         String          @default("manual")
  note           String?
  placement      Json?
  created_by     String?         @db.Uuid
  created_at     DateTime        @default(now()) @db.Timestamptz(6)
  updated_at     DateTime        @default(now()) @db.Timestamptz(6)
  student        student_profile @relation(fields: [student_id], references: [account_id], onDelete: Cascade, onUpdate: NoAction)
  items          score_item[]

  @@unique([student_id, period])
  @@index([period])
  @@index([center_id])
}

model score_item {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  report_id   String       @db.Uuid
  subject     String
  score       Decimal?     @db.Decimal(6, 2)
  max_score   Decimal?     @default(100) @db.Decimal(6, 2)
  grade       String?
  sub_subject String?
  created_at  DateTime     @default(now()) @db.Timestamptz(6)
  report      score_report @relation(fields: [report_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([report_id])
}

model audit_log {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actor_id    String?  @db.Uuid
  actor_name  String?
  actor_role  String?
  action      String
  target_type String?
  target_id   String?
  summary     String?
  meta        Json?
  center_id   String?  @db.Uuid
  request_id  String?
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  @@index([created_at(sort: Desc)])
  @@index([center_id])
}

model user_consent {
  account_id       String   @id @db.Uuid
  terms_version    String
  privacy_version  String
  marketing_agreed Boolean  @default(false)
  is_minor         Boolean  @default(false)
  guardian_name    String?
  guardian_contact String?
  agreed_at        DateTime @default(now()) @db.Timestamptz(6)
  account          account  @relation(fields: [account_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model blocked_time {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  center_id    String      @db.Uuid
  type         String?
  start_at     DateTime    @db.Timestamptz(6)
  end_at       DateTime    @db.Timestamptz(6)
  scope        String?
  set_by_level perm_level?
  center       center      @relation(fields: [center_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model board_question {
  id                                                                  String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  student_id                                                          String           @db.Uuid
  consult_type                                                        consult_type?
  q_type                                                              board_qtype
  scope                                                               board_scope
  assigned_teacher_id                                                 String?          @db.Uuid
  difficulty                                                          String?
  attachments                                                         Json?
  charge                                                              Int?
  status                                                              String?          @default("open")
  taken_teacher_id                                                    String?          @db.Uuid
  created_at                                                          DateTime         @default(now()) @db.Timestamptz(6)
  teacher_profile_board_question_assigned_teacher_idToteacher_profile teacher_profile? @relation("board_question_assigned_teacher_idToteacher_profile", fields: [assigned_teacher_id], references: [account_id], onDelete: NoAction, onUpdate: NoAction)
  student_profile                                                     student_profile  @relation(fields: [student_id], references: [account_id], onDelete: NoAction, onUpdate: NoAction)
  teacher_profile_board_question_taken_teacher_idToteacher_profile    teacher_profile? @relation("board_question_taken_teacher_idToteacher_profile", fields: [taken_teacher_id], references: [account_id], onDelete: NoAction, onUpdate: NoAction)
}

model booking {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  student_id          String                @db.Uuid
  teacher_id          String                @db.Uuid
  center_id           String?               @db.Uuid
  consult_type        consult_type
  sub_type            String?
  mode                consult_mode
  session_mode        session_mode?
  direction           booking_dir           @default(student)
  start_at            DateTime?             @db.Timestamptz(6)
  end_at              DateTime?             @db.Timestamptz(6)
  buffer_before       Int?                  @default(10) @db.SmallInt
  buffer_after        Int?                  @default(10) @db.SmallInt
  status              booking_status        @default(new)
  room_id             String?               @db.Uuid
  meeting_url         String?
  attachments         Json?
  content             String?
  charged_credits     Int?                  @default(0)
  origin              String?
  teacher_ack_at      DateTime?             @db.Timestamptz(6) // 선생님 상담 인지 확인(버튼/채팅·보드 입장) — 자동확정 예약 노쇼 판정 근거
  created_at          DateTime              @default(now()) @db.Timestamptz(6)
  center              center?               @relation(fields: [center_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  room                room?                 @relation(fields: [room_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  student_profile     student_profile       @relation(fields: [student_id], references: [account_id], onDelete: NoAction, onUpdate: NoAction)
  teacher_profile     teacher_profile       @relation(fields: [teacher_id], references: [account_id], onDelete: NoAction, onUpdate: NoAction)
  cancellation_event  cancellation_event[]
  consultation_note   consultation_note?
  chat_message        chat_message[]
  whiteboard_snapshot whiteboard_snapshot[]
  review              review?
  time_slot           time_slot[]

  @@index([student_id, status], map: "idx_booking_student")
  @@index([teacher_id, start_at], map: "idx_booking_teacher")
}

model cancellation_event {
  id                    String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  booking_id            String        @db.Uuid
  reason                String?
  route                 cancel_route?
  notify_targets        String[]      @default([])
  channels              String[]      @default([])
  credit_refunded       Int?          @default(0)
  cancelled_by          String?       @db.Uuid // 발생자(account id) — 0002
  substitute_candidates String[]      @default([]) @db.Uuid // 대체후보 teacher id — 0002
  created_at            DateTime      @default(now()) @db.Timestamptz(6)
  booking               booking       @relation(fields: [booking_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model category_mode_policy {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  center_id     String?        @db.Uuid
  consult_type  consult_type
  allowed_modes consult_mode[] @default([])
  center        center?        @relation(fields: [center_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model center {
  id                           String                         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                         String
  region                       String?
  created_at                   DateTime                       @default(now()) @db.Timestamptz(6)
  account                      account[]
  blocked_time                 blocked_time[]
  booking                      booking[]
  category_mode_policy         category_mode_policy[]
  consultation_policy          consultation_policy?
  evaluation_weight_policy     evaluation_weight_policy[]
  feature_availability         feature_availability[]
  material                     material[]
  guardian_visibility_policy   guardian_visibility_policy?
  limit_policy                 limit_policy?
  ops_stat                     ops_stat[]
  payroll_policy               payroll_policy[]
  penalty_policy               penalty_policy?
  pricing_policy               pricing_policy[]
  room                         room[]
  staff_profile                staff_profile[]
  student_profile              student_profile[]
  teacher_offline_availability teacher_offline_availability[]
  teacher_profile              teacher_profile[]
  zoom_policy                  zoom_policy?
}

model consultation_note {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  booking_id       String          @unique @db.Uuid
  student_id       String          @db.Uuid
  teacher_id       String          @db.Uuid
  consult_type     consult_type?
  sub_type         String?
  core_summary     String?
  memo             String?
  homework         String?
  future_dir       String?
  guardian_visible Boolean?        @default(true)
  save_state       note_save_state @default(draft)
  author_id        String?         @db.Uuid
  created_at       DateTime        @default(now()) @db.Timestamptz(6)
  updated_at       DateTime        @default(now()) @db.Timestamptz(6)
  booking          booking         @relation(fields: [booking_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  student_profile  student_profile @relation(fields: [student_id], references: [account_id], onDelete: NoAction, onUpdate: NoAction)
  teacher_profile  teacher_profile @relation(fields: [teacher_id], references: [account_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([student_id, created_at(sort: Desc)], map: "idx_note_student")
}

model consultation_policy {
  center_id           String @id @db.Uuid
  homeroom_cycle_days Int?   @default(30) @db.SmallInt
  warn_days           Int?   @db.SmallInt
  danger_days         Int?   @db.SmallInt
  center              center @relation(fields: [center_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model credit_account {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  student_id          String                @unique @db.Uuid
  purchased_balance   Int                   @default(0)
  granted_balance     Int                   @default(0)
  grant_expire_at     DateTime?             @db.Timestamptz(6)
  reserved_credits    Int                   @default(0)
  student_profile     student_profile       @relation(fields: [student_id], references: [account_id], onDelete: Cascade, onUpdate: NoAction)
  credit_transaction  credit_transaction[]
  weekly_credit_grant weekly_credit_grant[]
}

model credit_transaction {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  account_id     String          @db.Uuid
  type           credit_txn_type
  amount         Int
  balance        Int
  description    String?
  method         String?
  ref_type       String?
  ref_id         String?         @db.Uuid
  meta           Json? // 소비 분배 내역(부여분/구매분) — 환원 복원용 (0004)
  created_at     DateTime        @default(now()) @db.Timestamptz(6)
  credit_account credit_account  @relation(fields: [account_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([account_id, created_at(sort: Desc)], map: "idx_credit_txn_acct")
}

model feature_availability {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scope        String
  center_id    String?   @db.Uuid
  target_type  String
  target_value String
  period_start DateTime? @db.Date
  period_end   DateTime? @db.Date
  enabled      Boolean   @default(true)
  center       center?   @relation(fields: [center_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model guardian {
  account_id            String                  @id @db.Uuid
  notify_settings       Json?
  account               account                 @relation(fields: [account_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  guardian_student_link guardian_student_link[]
  payment_request       payment_request[]
}

model guardian_student_link {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  guardian_id     String          @db.Uuid
  student_id      String          @db.Uuid
  relation        String?
  status          String          @default("pending")
  link_method     String?
  guardian        guardian        @relation(fields: [guardian_id], references: [account_id], onDelete: Cascade, onUpdate: NoAction)
  student_profile student_profile @relation(fields: [student_id], references: [account_id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([guardian_id, student_id])
}

model guardian_visibility_policy {
  center_id   String @id @db.Uuid
  base_policy String @default("by_type")
  center      center @relation(fields: [center_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model limit_policy {
  center_id            String @id @db.Uuid
  reservation_limit    Int?   @db.SmallInt
  classify_fit_limit   Int?   @default(10) @db.SmallInt
  classify_unfit_limit Int?   @default(30) @db.SmallInt
  center               center @relation(fields: [center_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model match_request {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  student_id        String          @db.Uuid
  direction         booking_dir     @default(student)
  consult_type      consult_type?
  sub_type          String?
  mode_pref         String?
  stay_time         Json?
  result_booking_id String?         @db.Uuid
  fallback          String?
  created_at        DateTime        @default(now()) @db.Timestamptz(6)
  student_profile   student_profile @relation(fields: [student_id], references: [account_id], onDelete: NoAction, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model membership_grade {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                String
  tier                Int                   @db.SmallInt
  weekly_credits      Int                   @default(0)
  expire_policy       String                @default("end_of_week")
  priority            Int                   @default(0) @db.SmallInt
  active              Boolean               @default(true)
  student_profile     student_profile[]
  subscription_plan   subscription_plan[]
  weekly_credit_grant weekly_credit_grant[]
}

model notification {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recipient_id    String    @db.Uuid
  type            String?
  channels        String[]  @default([])
  payload         Json?
  delivery        Json?
  attempts        Int       @default(0)
  last_attempt_at DateTime? @db.Timestamptz(6)
  read_at         DateTime? @db.Timestamptz(6)
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  account         account   @relation(fields: [recipient_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model ops_stat {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  center_id        String?  @db.Uuid
  period           String?
  active_users     Int?
  match_rate       Decimal? @db.Decimal(4, 1)
  avg_satisfaction Decimal? @db.Decimal(2, 1)
  weekly_consult   Int?
  grade_dist       Json?
  weekly_trend     Json?
  teacher_stats    Json?
  center           center?  @relation(fields: [center_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model payment {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  payer_account_id String          @db.Uuid
  amount           Int
  pg_provider      String?
  pg_txn_id        String?
  target           String?
  status           String?         @default("pending")
  idempotency_key  String?         @unique
  refunded_at      DateTime?       @db.Timestamptz(6)
  created_at       DateTime        @default(now()) @db.Timestamptz(6)
  account          account         @relation(fields: [payer_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  payment_event    payment_event[]
}

/// PG 웹훅 멱등 원장 — (provider,event_id) 로 1회만 처리(재전송 방지). §9 O2·§10.
model payment_event {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider     String
  event_id     String
  type         String
  payment_id   String?   @db.Uuid
  payload      Json?
  status       String    @default("received")
  error        String?
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  processed_at DateTime? @db.Timestamptz(6)
  payment      payment?  @relation(fields: [payment_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@unique([provider, event_id])
  @@index([status, created_at])
}

model payment_request {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  student_id      String          @db.Uuid
  guardian_id     String?         @db.Uuid
  needed_credits  Int
  ref_type        String?
  ref_id          String?         @db.Uuid
  status          payreq_status   @default(open)
  origin          payreq_origin   @default(manual)
  expire_at       DateTime?       @db.Timestamptz(6)
  channels        String[]        @default([])
  created_at      DateTime        @default(now()) @db.Timestamptz(6)
  guardian        guardian?       @relation(fields: [guardian_id], references: [account_id], onDelete: NoAction, onUpdate: NoAction)
  student_profile student_profile @relation(fields: [student_id], references: [account_id], onDelete: NoAction, onUpdate: NoAction)
}

model payroll_estimate {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teacher_id       String          @db.Uuid
  cycle            String?
  confirmed_amount Int?            @default(0)
  expected_amount  Int?            @default(0)
  breakdown        Json?
  status           String          @default("draft") // draft|confirmed|paid
  deductions       Json?
  net_amount       Int?
  paid_at          DateTime?       @db.Timestamptz(6)
  settled_by       String?         @db.Uuid
  period_start     DateTime?       @db.Date
  period_end       DateTime?       @db.Date
  tutor_source     String? // 고용유형 스냅샷(freelance|salaried) — 계측 차원, 금액 계산 무관
  teacher_profile  teacher_profile @relation(fields: [teacher_id], references: [account_id], onDelete: Cascade, onUpdate: NoAction)
}

model member_type {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind       String
  code       String
  label      String
  sort_order Int      @default(0)
  active     Boolean  @default(true)
  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@unique([kind, code])
}

model scheduled_announcement {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_by    String    @db.Uuid
  targets       String[]
  title         String
  body          String
  center_id     String?   @db.Uuid
  channels      String[]  @default(["app"])
  scheduled_at  DateTime  @db.Timestamptz(6)
  status        String    @default("pending")
  sent_at       DateTime? @db.Timestamptz(6)
  sent_count    Int?
  reminder_sent Boolean   @default(false)
  created_at    DateTime  @default(now()) @db.Timestamptz(6)

  @@index([status, scheduled_at])
}

model announcement_template {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_by String   @db.Uuid
  center_id  String?  @db.Uuid
  name       String
  targets    String[]
  title      String
  body       String
  channels   String[] @default(["app"])
  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@index([center_id])
}

model stored_file {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  owner_id     String     @db.Uuid
  storage_key  String
  filename     String
  content_type String
  size         Int
  created_at   DateTime   @default(now()) @db.Timestamptz(6)
  material     material[]

  @@index([owner_id])
}

model material {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teacher_id  String          @db.Uuid
  center_id   String?         @db.Uuid
  file_id     String?         @db.Uuid
  title       String
  description String?
  subject     String?
  category    String?
  visibility  String          @default("center")
  view_count  Int             @default(0)
  created_at  DateTime        @default(now()) @db.Timestamptz(6)
  teacher     teacher_profile @relation(fields: [teacher_id], references: [account_id], onDelete: Cascade, onUpdate: NoAction)
  center      center?         @relation(fields: [center_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  file        stored_file?    @relation(fields: [file_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([center_id])
  @@index([teacher_id])
}

model category {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind       String
  name       String
  sort_order Int      @default(0)
  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@unique([kind, name])
}

model payroll_policy {
  id               String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  center_id        String? @db.Uuid
  teacher_category String?
  cycle            String  @default("monthly")
  per_case_rate    Int?
  qna_rate         Int?
  grade_allowance  Json?
  hourly_rate      Int?
  auto_incentive   Json?
  center           center? @relation(fields: [center_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model penalty_policy {
  center_id           String   @id @db.Uuid
  cancel_threshold    Int?     @db.SmallInt
  noshow_threshold    Int?     @db.SmallInt
  reject_threshold    Int?     @db.SmallInt
  restrict_minutes    Int?
  ranking_weight_down Decimal? @db.Decimal(4, 2)
  center              center   @relation(fields: [center_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model pricing_policy {
  id                    String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  center_id             String?      @db.Uuid
  mode                  consult_mode
  enabled               Boolean      @default(true)
  paid                  Boolean      @default(true)
  per_hour              Int          @default(0)
  surcharge_pct         Int          @default(0) @db.SmallInt
  board_item_fee        Int?
  board_general_fee     Int?
  offline_occupancy_fee Int?
  paid_consulting_fee   Int?
  updated_by            String?      @db.Uuid
  updated_at            DateTime?    @default(now()) @db.Timestamptz(6)
  center                center?      @relation(fields: [center_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/**
 * 보호자 동의 원장(본부 결정 2026-07-19) — 미성년 음성 외부 STT 전송은 동의 학생 한정. kind 확장형.
 */
model consent_grant {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  student_id     String    @db.Uuid
  guardian_id    String    @db.Uuid
  kind           String    @default("recording_stt")
  policy_version String    @default("v1")
  granted_at     DateTime  @default(now()) @db.Timestamptz(6)
  revoked_at     DateTime? @db.Timestamptz(6)

  @@unique([student_id, kind])
}

/**
 * R1 상담 오디오 녹음 원장(브리핑 v1) — 동의·egress·보관·파기 추적. booking 조인 키 전용(기존 테이블 무변경).
 */
model consult_recording {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  booking_id             String    @unique @db.Uuid
  egress_id              String?
  s3_key                 String?
  duration_sec           Int?
  size_bytes             BigInt?
  consent_student_at     DateTime? @db.Timestamptz(6)
  consent_teacher_at     DateTime? @db.Timestamptz(6)
  consent_policy_version String    @default("v1")
  consent_guardian_at    DateTime? @db.Timestamptz(6)
  status                 String    @default("pending")
  expires_at             DateTime? @db.Timestamptz(6)
  purged_at              DateTime? @db.Timestamptz(6)
  created_at             DateTime  @default(now()) @db.Timestamptz(6)

  @@index([status, expires_at])
}

// R2 — 상담 전사문(STT 산출). 녹음당 1건(재실행 시 교체). 보관은 정책값 retentionDays 준용.
model consult_transcript {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recording_id String   @unique @db.Uuid
  engine       String
  lang         String   @default("ko")
  text         String
  created_at   DateTime @default(now()) @db.Timestamptz(6)
}

// R3~R4 — 상담 요약 리포트. body = {covered[], diagnosis, next_actions[]}. 전건 검수(draft→approved→sent).
model consult_report {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  booking_id    String    @unique @db.Uuid
  transcript_id String?   @db.Uuid
  body          Json
  status        String    @default("draft")
  approved_by   String?   @db.Uuid
  sent_at       DateTime? @db.Timestamptz(6)
  opened_at     DateTime? @db.Timestamptz(6)
  created_at    DateTime  @default(now()) @db.Timestamptz(6)
  updated_at    DateTime  @default(now()) @db.Timestamptz(6)

  @@index([status])
}

// 상담 요약 리포트 2뷰(학생용/학부모용) — 원 consult_report 무변경, audience별 검수·공유·열람 상태 보유.
model consult_report_view {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  report_id   String    @db.Uuid
  audience    String
  body        Json
  status      String    @default("draft")
  approved_by String?   @db.Uuid
  shared_at   DateTime? @db.Timestamptz(6)
  opened_at   DateTime? @db.Timestamptz(6)
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  updated_at  DateTime  @default(now()) @db.Timestamptz(6)

  @@unique([report_id, audience])
  @@index([report_id])
}

// R5 — 민감 산출물(녹음·전사·리포트) 접근 감사 로그.
model media_access_log {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  target_type String
  target_id   String   @db.Uuid
  actor_id    String?  @db.Uuid
  action      String
  at          DateTime @default(now()) @db.Timestamptz(6)

  @@index([target_type, target_id, at])
}

model qna_followup {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  answer_id  String     @db.Uuid
  author_id  String     @db.Uuid
  body       String
  created_at DateTime   @default(now()) @db.Timestamptz(6)
  qna_answer qna_answer @relation(fields: [answer_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([answer_id, created_at])
}

model qna_answer {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  post_id         String          @db.Uuid
  teacher_id      String          @db.Uuid
  body            String?
  attachments     Json? // P4 답변 첨부(화이트보드 풀이 PNG 등) — [{id,name,type}]
  qna_followup    qna_followup[] // C2 후속 문답(이어 묻기·이어 답하기)
  accepted        Boolean?        @default(false)
  pay_eligible    Boolean?        @default(false)
  similarity      Decimal?        @db.Decimal(3, 2)
  similar_to_id   String?         @db.Uuid
  sim_flagged     Boolean         @default(false)
  created_at      DateTime        @default(now()) @db.Timestamptz(6)
  qna_post        qna_post        @relation(fields: [post_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  teacher_profile teacher_profile @relation(fields: [teacher_id], references: [account_id], onDelete: NoAction, onUpdate: NoAction)
}

model qna_post {
  id                   String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  student_id           String           @db.Uuid
  subject              String?
  difficulty           String?
  scope                board_scope?     @default(open)
  assigned_teacher_id  String?          @db.Uuid
  body                 String?
  attachments          Json?
  status               String?          @default("open")
  scheduled_booking_id String?          @db.Uuid
  created_at           DateTime         @default(now()) @db.Timestamptz(6)
  claimed_at           DateTime?        @db.Timestamptz(6) // Q1 SLA — 클레임/배정 시점
  first_reply_at       DateTime?        @db.Timestamptz(6) // Q1 SLA — 첫 응답 시점
  resolved_at          DateTime?        @db.Timestamptz(6) // Q1 SLA — 해결(채택) 시점
  rating               Int?             @db.SmallInt // Q1 해결 만족도(1~5)
  continue_pref        Boolean? // Q1 "이 선생님께 계속 받을까요"
  reanswer_count       Int              @default(0) // 재답변 요청 횟수(한도 qa.reanswerLimit)
  reanswer_reason      String? // 마지막 재답변 사유
  free_used            Boolean          @default(false) // P1 주간 무료 질문권으로 등록됨(과금 0) — 주간 사용량 집계 기준
  escalated_at         DateTime?        @db.Timestamptz(6) // P2 AI 1층→선생님 답변 요청 시점(과금·SLA 기산점)
  escalated_booking_id String?          @db.Uuid // 상담 승격 시 생성된 예약
  ai_draft             String? // Q3 AI 1차 초안("AI 생성" 라벨)
  ai_draft_at          DateTime?        @db.Timestamptz(6)
  community            Boolean          @default(false) // Q3 커뮤니티(무료·전원답변) 질문
  hidden               Boolean          @default(false) // 신고 누적·모더레이션 숨김
  report_count         Int              @default(0)
  qna_answer           qna_answer[]
  teacher_profile      teacher_profile? @relation(fields: [assigned_teacher_id], references: [account_id], onDelete: NoAction, onUpdate: NoAction)
  student_profile      student_profile  @relation(fields: [student_id], references: [account_id], onDelete: NoAction, onUpdate: NoAction)
}

/**
 * B1 질문권 묶음 — 크레딧으로 선구매한 질문권 잔여 관리(FIFO 소진). 소진 순서: 주간무료→묶음→크레딧.
 */
model qna_ticket_bundle {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  student_id   String    @db.Uuid
  count        Int
  remaining    Int
  credits_paid Int
  unit_credits Int
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  expires_at   DateTime? @db.Timestamptz(6)

  @@index([student_id])
}

/**
 * Q3 커뮤니티 답변(무료·전원 답변) — 유료 qna_answer 와 분리. 작성자=임의 계정(학생·교사).
 */
model qna_community_answer {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  post_id      String   @db.Uuid
  author_id    String   @db.Uuid
  body         String?
  accepted     Boolean  @default(false)
  hidden       Boolean  @default(false)
  report_count Int      @default(0)
  similarity   Decimal? @db.Decimal(3, 2)
  ai_similar   Boolean  @default(false)
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  updated_at   DateTime @default(now()) @db.Timestamptz(6)

  @@index([post_id])
  @@index([author_id])
}

/**
 * Q3 신고 — 대상(post|answer)별 신고자 1회. 누적 시 hidden 처리.
 */
model qna_report {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  target_type String
  target_id   String   @db.Uuid
  reporter_id String   @db.Uuid
  reason      String?
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  @@unique([target_type, target_id, reporter_id])
}

/**
 * Q3 리그 — 커뮤니티 답변 실적 기반 답변자 등급(3부 기본→2부→1부). 임계값은 system_setting.
 */
model qna_league {
  account_id   String    @id @db.Uuid
  tier         Int       @default(3) @db.SmallInt
  authored     Int       @default(0)
  accepted     Int       @default(0)
  accept_rate  Int       @default(0)
  promoted_at  DateTime? @db.Timestamptz(6)
  evaluated_at DateTime  @default(now()) @db.Timestamptz(6)

  @@index([tier, accepted(sort: Desc)])
}

// N33 축 A(신뢰) — 답변자 자기신고 자격(claimed). verified 는 후속(IdentityVerify 연동).
model answerer_credential {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  account_id    String    @db.Uuid
  subject       String
  claimed_grade String?
  verify_tier   String    @default("claimed")
  verified_at   DateTime? @db.Timestamptz(6)
  note          String?
  created_at    DateTime  @default(now()) @db.Timestamptz(6)
  updated_at    DateTime  @default(now()) @db.Timestamptz(6)

  @@unique([account_id, subject])
  @@index([account_id])
}

// N33 축 B(능력·설명방식 오각형) — 답변 수령자의 재평가(자기신고 아님).
model answer_rating {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  answer_id  String   @db.Uuid
  rater_id   String   @db.Uuid
  axis       String
  score      Int      @db.SmallInt
  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@unique([answer_id, rater_id, axis])
  @@index([answer_id])
}

/**
 * Q1 소프트 블록 — 학생이 특정 선생님에게 질문을 노출/배정하지 않음(선생님 비공지, 학생 해제 가능).
 */
model qna_relation_block {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  student_id String   @db.Uuid
  teacher_id String   @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@unique([student_id, teacher_id])
  @@index([teacher_id])
}

model report {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  target_type String?
  target_id   String?  @db.Uuid
  reason      String?
  status      String?  @default("received")
  action      String?
  center_id   String?  @db.Uuid // 센터 스코프(0003)
  ai_review   Json? // AI 1차 검토 결과 보존(0003)
  created_at  DateTime @default(now()) @db.Timestamptz(6)
}

model review {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  booking_id      String          @unique @db.Uuid
  student_id      String          @db.Uuid
  teacher_id      String          @db.Uuid
  rating_attitude Int?            @db.SmallInt
  rating_content  Int?            @db.SmallInt
  rating_skill    Int?            @db.SmallInt
  rating_again    Int?            @db.SmallInt
  text            String?
  done_confirmed  Boolean?        @default(false)
  reported        Boolean?        @default(false)
  created_at      DateTime        @default(now()) @db.Timestamptz(6)
  booking         booking         @relation(fields: [booking_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  student_profile student_profile @relation(fields: [student_id], references: [account_id], onDelete: NoAction, onUpdate: NoAction)
  teacher_profile teacher_profile @relation(fields: [teacher_id], references: [account_id], onDelete: NoAction, onUpdate: NoAction)
}

model room {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  center_id       String    @db.Uuid
  type            String?
  capacity        Int?      @default(1) @db.SmallInt
  operating_hours String?
  setting         String?   @default("auto")
  status          String?   @default("available")
  booking         booking[]
  center          center    @relation(fields: [center_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model staff_profile {
  account_id String     @id @db.Uuid
  staff_role String?
  center_id  String?    @db.Uuid
  perm_level perm_level @default(L2)
  account    account    @relation(fields: [account_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  center     center?    @relation(fields: [center_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model student_profile {
  account_id             String                  @id @db.Uuid
  center_id              String?                 @db.Uuid
  stay_time              Json?
  membership_grade_id    String?                 @db.Uuid
  active_subscription_id String?                 @db.Uuid
  homeroom_teacher_id    String?                 @db.Uuid
  homeroom_assigned_at   DateTime?               @db.Timestamptz(6)
  school_grade           String?
  total_consult          Int?                    @default(0)
  done_count             Int?                    @default(0)
  rejected_count         Int?                    @default(0)
  noshow_count           Int?                    @default(0)
  same_day_cancel_count  Int?                    @default(0)
  penalty_since          DateTime?               @db.Timestamptz(6)
  type_code              String?
  last_consult_at        DateTime?               @db.Timestamptz(6)
  last_homeroom_at       DateTime?               @db.Timestamptz(6)
  reverse_admin          Boolean                 @default(false)
  reverse_self           Boolean                 @default(false)
  board_question         board_question[]
  booking                booking[]
  consultation_note      consultation_note[]
  credit_account         credit_account?
  guardian_student_link  guardian_student_link[]
  match_request          match_request[]
  payment_request        payment_request[]
  goal_tier              String?
  goal_avg               Int?
  /// janus_goal 규약 — 목표 대학·학과(자가목표 GET/PUT /me/goal). 격차 리포트 target 프리필·상담·컨설팅 공유.
  goal_university        String?
  goal_department        String?
  qna_post               qna_post[]
  review                 review[]
  score_report           score_report[]
  account                account                 @relation(fields: [account_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  center                 center?                 @relation(fields: [center_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  teacher_profile        teacher_profile?        @relation(fields: [homeroom_teacher_id], references: [account_id], onDelete: NoAction, onUpdate: NoAction)
  membership_grade       membership_grade?       @relation(fields: [membership_grade_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  student_subscription   student_subscription[]
  teacher_block          teacher_block[]
  teacher_list_entry     teacher_list_entry[]
}

model student_subscription {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  student_id        String            @db.Uuid
  plan_id           String            @db.Uuid
  status            String?           @default("active")
  started_at        DateTime?         @default(now()) @db.Timestamptz(6)
  next_billing_at   DateTime?         @db.Timestamptz(6)
  subscription_plan subscription_plan @relation(fields: [plan_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  student_profile   student_profile   @relation(fields: [student_id], references: [account_id], onDelete: Cascade, onUpdate: NoAction)
}

model subscription_plan {
  id                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                 String
  price                Int
  billing_cycle        billing_cycle
  payer                payer_t                @default(guardian)
  grade_id             String?                @db.Uuid
  included_products    Json                   @default("[]")
  student_subscription student_subscription[]
  membership_grade     membership_grade?      @relation(fields: [grade_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model teacher_block {
  student_id      String          @db.Uuid
  teacher_id      String          @db.Uuid
  student_profile student_profile @relation(fields: [student_id], references: [account_id], onDelete: NoAction, onUpdate: NoAction)
  teacher_profile teacher_profile @relation(fields: [teacher_id], references: [account_id], onDelete: NoAction, onUpdate: NoAction)

  @@id([student_id, teacher_id])
}

model teacher_grade {
  teacher_id      String          @id @db.Uuid
  grade           teacher_grade_t
  top_percent     Decimal?        @db.Decimal(4, 1)
  next_review_at  DateTime?       @db.Date
  allowance       Json?
  teacher_profile teacher_profile @relation(fields: [teacher_id], references: [account_id], onDelete: Cascade, onUpdate: NoAction)
}

model teacher_list_entry {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  student_id      String          @db.Uuid
  teacher_id      String          @db.Uuid
  list_kind       list_kind
  student_profile student_profile @relation(fields: [student_id], references: [account_id], onDelete: Cascade, onUpdate: NoAction)
  teacher_profile teacher_profile @relation(fields: [teacher_id], references: [account_id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([student_id, teacher_id])
}

model teacher_offline_availability {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teacher_id      String          @db.Uuid
  center_id       String          @db.Uuid
  enabled         Boolean         @default(false)
  time_windows    Json            @default("[]")
  center          center          @relation(fields: [center_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  teacher_profile teacher_profile @relation(fields: [teacher_id], references: [account_id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([teacher_id, center_id])
}

model teacher_profile {
  account_id                                                         String                         @id @db.Uuid
  center_id                                                          String?                        @db.Uuid
