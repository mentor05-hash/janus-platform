# =========================================================
# 잇올 멘토링 API — 환경변수 예시 (.env.example)
# 복사: cp .env.example .env   (실제 .env는 git 제외)
# 원칙(§10): 모든 환경 의존값은 ENV. 코드 하드코딩 금지.
# =========================================================

NODE_ENV=local            # local | staging | prod
PORT=3000
API_PREFIX=/api/v1

# ---- DB / 캐시 ----
DATABASE_URL=postgresql://itall:itall_local_pw@localhost:5432/itall
REDIS_URL=redis://localhost:6379

# ---- 인증 ----
JWT_SECRET=change_me_local_access
JWT_REFRESH_SECRET=change_me_local_refresh
JWT_ACCESS_TTL=900            # 15m
JWT_REFRESH_TTL=1209600       # 14d

# ---- 스케줄러(크레딧 주간 부여/소멸) ----
WEEKLY_GRANT_CRON=0 0 * * 1   # 월요일 00:00 부여
GRANT_EXPIRE_CRON=59 23 * * 0 # 일요일 24:00 직전 소멸

# ---- 외부 의존 어댑터(로컬 구현 → 클라우드 교체) ----
PG_PROVIDER=mock              # mock | toss | portone   (🔲 O2)
NOTIFICATION_PROVIDER=mock    # mock | (app/sms/kakao)
KAKAO_ALIMTALK_KEY=
SMS_API_KEY=
STORAGE_PROVIDER=local        # local | s3 | gcs   (첨부 파일)
STORAGE_LOCAL_PATH=./uploads
LLM_PROVIDER=none             # none | claude | gpt | ...  (제품 AI, Phase 3)
ZOOM_PROVIDER=mock            # mock | zoom | googlemeet

# ---- 정책 기본값(관리자 설정 전 fallback · 🔲 미결정 단가) ----
CREDIT_TO_KRW=1               # 내부 회계용(화면 비노출). 실제 비율 추후(O1)
PAID_CONSULTING_FEE=          # 입시 유료컨설팅 단가 (🔲 O33)
OFFLINE_OCCUPANCY_FEE=        # 오프라인 점유 기본요금 (🔲 O5)
PENALTY_RESTRICT_MINUTES=     # 가중 제한 시간 (🔲 O31)
HOMEROOM_CYCLE_DAYS=30        # 담임 상담 목표 주기(월 1회)
PRE_BOOK_HORIZON_DAYS=30      # 선예약 가능 기간(최소 1개월)
