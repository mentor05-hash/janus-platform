{
  "name": "@mentoring/api",
  "version": "0.0.1",
  "description": "멘토링 플랫폼 — NestJS 백엔드 API",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint:budget": "node scripts/lint-budget.mjs",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand",
    "migration:apply": "prisma db execute --file migrations/0001_init.sql --schema prisma/schema.prisma",
    "migrate:all": "node scripts/apply-migrations.mjs",
    "migrate:check": "node scripts/check-migrations.mjs",
    "prisma:pull": "prisma db pull",
    "prisma:generate": "prisma generate",
    "db:init": "npm run migrate:all && npm run prisma:generate",
    "seed": "ts-node prisma/seed.ts",
    "seed:sim": "prisma db execute --file prisma/seed-sim.sql --schema prisma/schema.prisma",
    "seed:sim:schedules": "prisma db execute --file prisma/seed-sim-schedules.sql --schema prisma/schema.prisma",
    "seed:sim:large": "prisma db execute --file prisma/seed-sim-large.sql --schema prisma/schema.prisma",
    "seed:sim:bulk": "prisma db execute --file prisma/seed-sim-bulk-bookings.sql --schema prisma/schema.prisma",
    "seed:sim:consult": "prisma db execute --file prisma/seed-sim-consultations.sql --schema prisma/schema.prisma",
    "seed:sim:credits": "prisma db execute --file prisma/seed-sim-credit-ledger.sql --schema prisma/schema.prisma",
    "seed:sim:notif": "prisma db execute --file prisma/seed-sim-notifications.sql --schema prisma/schema.prisma",
    "seed:sim:scores": "prisma db execute --file prisma/seed-sim-scores.sql --schema prisma/schema.prisma",
    "erd": "node scripts/gen-erd.mjs > ../../docs/ERD.mmd",
    "build:seed": "tsc prisma/seed.ts --outDir dist-seed --module commonjs --target ES2020 --esModuleInterop --skipLibCheck",
    "seed:prod": "node dist-seed/prisma/seed.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1078.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.0",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/platform-socket.io": "^11.1.27",
    "@nestjs/schedule": "^6.0.0",
    "@nestjs/swagger": "^11.4.5",
    "@nestjs/websockets": "^11.1.27",
    "@prisma/client": "^6.2.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "helmet": "^8.2.0",
    "ioredis": "^5.4.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.13.1",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^7.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "prisma": "^6.2.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
