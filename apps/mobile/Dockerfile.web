# 잇올 멘토링 Mobile(학생·학부모) — expo-web 정적 서빙 + /api 프록시.
# dist 는 사전 빌드(레포 루트에서):
#   cd apps/mobile && EXPO_PUBLIC_API_BASE=/api/v1 npx expo export -p web
# 그 뒤 도커 빌드(컨텍스트=레포 루트):
#   docker build -f apps/mobile/Dockerfile.web -t itall-mobile .
#
# (도커 내부에서 expo export 를 돌리지 않는 이유: metro/expo 알파인 빌드가 느리고 불안정.
#  사전 빌드 산출물(dist)을 그대로 nginx 로 서빙하는 편이 재현성·속도 모두 우수.)
FROM nginx:alpine
COPY apps/mobile/nginx.web.conf /etc/nginx/conf.d/default.conf
COPY apps/mobile/dist /usr/share/nginx/html
EXPOSE 80
