# ─────────────────────────────────────────────────────────────
# 멘토링 플랫폼 환경변수 템플릿 (production)
#   cp .env.example .env  후 실값 채우기. 실서비스 시크릿은 시크릿 매니저 사용 권장.
#   provider 스위치를 mock/stub → 실연동으로 바꿀 때 해당 자격증명도 함께 설정.
# ─────────────────────────────────────────────────────────────

# ── 런타임/프로파일 ──
NODE_ENV=production           # production 이면 helmet HSTS·mock PG 차단 등 안전장치 활성
APP_ENV=prod                  # local | staging | prod
PORT=3000
API_PREFIX=/api/v1
LOG_FORMAT=json               # json(운영) | pretty(개발)
CORS_ORIGINS=https://app.example.com,https://m.example.com   # 웹·모바일 도메인

# ── DB / 캐시 ──
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/itall?schema=public
CACHE_PROVIDER=redis          # memory | redis (실서비스=redis 권장: 수평확장·세션·크론락)
REDIS_URL=redis://HOST:6379

# ── 인증 시크릿(반드시 강한 랜덤값, 별도 관리) ──
JWT_SECRET=__CHANGE_ME_32B_RANDOM__
JWT_REFRESH_SECRET=__CHANGE_ME_ANOTHER_32B_RANDOM__

# ── 스케줄러(크론) ──
WEEKLY_GRANT_CRON=0 0 * * 1           # 월 00:00 주간 크레딧 부여
GRANT_EXPIRE_CRON=59 23 * * 0         # 일 24:00 직전 소멸
SUBSCRIPTION_BILLING_CRON=0 1 * * *   # 구독 정기결제 처리
NOTIFICATION_RETRY_CRON=*/5 * * * *   # 알림 실패 재시도

# ── 외부 연동 provider 스위치(②) ──
# 결제 PG: mock(무료·프로덕션 차단) | real
PG_PROVIDER=mock
# real 선택 시 PG 자격증명(벤더별): 예) 토스페이먼츠/포트원 등
# PG_API_KEY=
# PG_SECRET_KEY=

# 알림 채널: stub(로그만) | 실채널(카카오 알림톡/SMS)
# KAKAO_ALIMTALK_KEY=
# KAKAO_SENDER_KEY=
# SMS_PROVIDER_KEY=

# 파일 스토리지: local | s3
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=/data/uploads
STORAGE_S3_BUCKET=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=ap-northeast-2

# 화상(줌): mock | api
ZOOM_PROVIDER=mock
ZOOM_ACCOUNT_ID=
# ZOOM_CLIENT_ID=
# ZOOM_CLIENT_SECRET=

# AI(LLM): mock(휴리스틱) | claude(실모델 — 신고검토·성적 OCR·답변 유사도)
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── 급여 단가 기본값(정책 테이블 미설정 시 폴백, 원) ──
PAYROLL_PER_CASE_RATE=30000
PAYROLL_QNA_RATE=5000
PAYROLL_GRADE_ALLOWANCE=0
PAYROLL_HOURLY_RATE=0
PAYROLL_STALE_BONUS=0

# ── 대시보드 옵션 ──
DASH_BENCHMARK_ANON=false     # 센터관리자에게 익명 평균 벤치마크 노출 여부

# ── 프론트 빌드 플래그(데모 편의) ──
# 실서비스 배포에선 반드시 미설정/false (자동로그인·기본 비번 노출 방지 — 보안①)
# VITE_DEMO_MODE=            # 웹(Dockerfile ARG)
# EXPO_PUBLIC_DEMO_MODE=     # 모바일(export)
